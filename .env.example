# Natasha — container environment (copy to .env and edit)
#
# NOTE WHAT IS *NOT* HERE: provider API keys, tokens and secrets. This project deliberately does not
# read credentials from the environment (see natasha.core.config._apply_env, which ignores any
# NATASHA_API_KEY*/NATASHA_SECRET*/NATASHA_TOKEN* variable). Keys live in the encrypted vault under
# $NATASHA_HOME and are handed to tools by the credential broker. Add them once:
#
#   docker compose exec -it natasha natasha credentials add openai     # prompts, not echoed
#   (or: the Providers screen in the web console)
#
# Bind address on the host. Keep 127.0.0.1 unless a reverse proxy terminates TLS in front: the API
# requires owner authentication, but plain HTTP over a LAN is still plain HTTP.
NATASHA_BIND_ADDR=127.0.0.1
NATASHA_PORT=8000
NATASHA_LOG_LEVEL=INFO

# Where the agent keeps its data inside the container. The volume is declared in docker-compose.yml.
NATASHA_HOME=/data

# Settings file layered on top of the built-in defaults. The image ships /app/config/natasha.toml.
NATASHA_CONFIG=/app/config/natasha.toml

# Nested settings use a double underscore:
#   NATASHA_LIMITS__ENABLED=false
#   NATASHA_PROVIDERS__OLLAMA__BASE_URL=http://ollama:11434
#   NATASHA_EXECUTIVE__MAX_STEPS=80
#   NATASHA_BRAIN__PREFER_LOCAL=false
#   NATASHA_SECURITY__DEFAULT_EFFECT=allow        # do not do this in production

# ---------------------------------------------------------------- optional: PostgreSQL
# HONEST STATUS: the migration runner applies the migrations/postgres schema to a PostgreSQL
# database (needs the `postgres` extra: pip install ".[postgres]"), but the runtime stores themselves
# are SQLite-only today - natasha serve does not read NATASHA_MEMORY__DB_BACKEND yet. Use this
# profile to run/verify the Postgres schema and migration path; see docs/deployment.md.
#POSTGRES_USER=natasha
#POSTGRES_PASSWORD=change-me
#POSTGRES_DB=natasha

# ---------------------------------------------------------------- optional: MCP servers
# MCP servers are configured through the agent (natasha mcp add ...), not through environment
# variables, so their permissions can be reviewed and approved by the owner.
